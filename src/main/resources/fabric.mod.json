{
  "schemaVersion": 1,
  "id": "clickmanaita",
  "version": "${version}",
  "name": "ClickManaita",
  "description": "CheatMod",
  "authors": [
    "takusan_23"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/clickmanaita",
    "sources": "https://github.com/takusan23/ClickManaita2/tree/26.1-fabric"
  },
  "license": "Apache-2.0 License",
  "icon": "assets/clickmanaita/textures/item/clickmanaita_wood.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.takusan23.clickmanaita.ClickManaitaKt::init"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.takusan23.clickmanaita.ClickManaitaClientKt::initClient"
      }
    ]
  },
  "mixins": [
    "clickmanaita.mixins.json",
    {
      "config": "clickmanaita.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}